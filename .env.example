# Security API Key for Webhook and API Endpoints
MASTER_API_KEY=instapay_secret_master_key_2026

# Database Connection URL (SQLite default, or postgresql://user:password@localhost:5432/instapay)
DATABASE_URL=sqlite:///./data/instapay.db

# Matching fallback window in minutes for unclaimed credits
MATCH_WINDOW_MINUTES=30

# ==============================================================================
# Email Dispatch Settings (Brevo / Sendinblue / Gmail SMTP)
# ==============================================================================
# Brevo SMTP Relay Settings (300 free emails / day)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_account_email@domain.com
SMTP_PASSWORD=your_brevo_smtp_master_key_here
SMTP_FROM="InstaPay Portal <your_verified_sender@domain.com>"
SMTP_TLS=true
